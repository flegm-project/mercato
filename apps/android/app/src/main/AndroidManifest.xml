<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Ads need network access; gameplay itself is fully offline. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!--
      The daily reminder. Asked for from the Notifications switch in Settings
      and nowhere else, so a player who never turns it on is never prompted.
      RECEIVE_BOOT_COMPLETED exists because an alarm does not survive a
      restart: without it the reminder stops the first time the phone reboots.
    -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!--
      appCategory is not decoration. Android 16 ignores android:screenOrientation
      on any display at least 600dp wide, so on a tablet or an unfolded foldable
      the portrait lock below would simply not apply. Games are exempt from that
      override, and this is a game. The alternative, the
      PROPERTY_COMPAT_ALLOW_RESTRICTED_RESIZABILITY property, stops working at
      targetSdk 37, so it would buy one year and a migration.
    -->
    <application
        android:appCategory="game"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:name=".MercatoApplication"
        android:label="Mercato"
        android:allowBackup="true"
        android:fullBackupContent="@xml/backup_rules"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:supportsRtl="true"
        android:theme="@style/Theme.Mercato">

        <!-- AdMob application id, injected per build type from build.gradle. -->
        <meta-data
            android:name="com.google.android.gms.ads.APPLICATION_ID"
            android:value="${admobAppId}" />

        <!--
          Portrait only. Every screen is one column: the transfer card, then
          the four choices or the text field, then the keyboard. Turned
          sideways there is no room for the card and the answer at once, and
          nothing in the game gains from the width.
        -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize"
            android:screenOrientation="portrait"
            android:configChanges="orientation|screenSize|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          Fires the daily reminder, and re-arms it after a reboot.

          Exported because BOOT_COMPLETED is delivered by the system, which is
          another uid: a non-exported receiver simply never hears it, and the
          reminder would stop at the first restart. BOOT_COMPLETED is a
          protected broadcast, so no other app can send it, and the worst any
          app could do with the alarm path is make this phone show its own
          reminder a few hours early.
        -->
        <receiver
            android:name=".ReminderReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
