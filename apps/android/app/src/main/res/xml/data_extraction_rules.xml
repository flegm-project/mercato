<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12 and above (android:dataExtractionRules). Same intent as
  backup_rules.xml, but this format splits cloud backup from device-to-device
  transfer, and the entitlement must be excluded from both: a transfer carries
  the same file as a cloud restore, so leaving it in either path would hand
  remove-ads over for free. Everything else, the progression the player earned,
  is left in so a new phone keeps it. Paths are relative to getFilesDir().
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="datastore/entitlement.preferences_pb" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="datastore/entitlement.preferences_pb" />
    </device-transfer>
</data-extraction-rules>
