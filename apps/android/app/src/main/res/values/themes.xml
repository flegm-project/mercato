<?xml version="1.0" encoding="utf-8"?>
<!--
  The launch window, painted before any of the app's code runs.

  It used to be Theme.Material.NoActionBar, whose window background is the
  system default: a sheet of grey with the launcher icon on it, and then a jump
  into the blue app. iOS paints its launch screen in the app's own background
  (project.yml, UILaunchScreen -> LaunchBackground) so the hand-off to the
  wordmark splash is invisible, and this is the same thing.

  launch_background is generated from design/tokens.json, because XML cannot
  read the Kotlin token object.
-->
<resources>
  <style name="Theme.Mercato" parent="@android:style/Theme.Material.NoActionBar">
    <item name="android:windowBackground">@color/launch_background</item>
    <item name="android:colorBackground">@color/launch_background</item>
    <item name="android:navigationBarColor">@color/launch_background</item>
    <item name="android:statusBarColor">@android:color/transparent</item>
  </style>
</resources>
