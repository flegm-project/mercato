# ---- OS / editor ----
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/

# ---- Rust ----
/core/target/
**/target/
*.rs.bk
# Cargo.lock is committed: reproducible CI now, and the workspace will ship
# app binaries later.

# ---- Generated data artifacts (source of truth is data/*.csv) ----
/data/build/out/
*.db
*.sqlite
*.sqlite3
!/reference/web-prototype/**   # keep the historical prototype intact

# ---- iOS ----
# The project is generated from apps/ios/project.yml by xcodegen.
*.xcodeproj

/apps/ios/build/
/apps/ios/DerivedData/
*.xcuserstate
*.xcworkspace/xcuserdata/
Pods/

# ---- Android ----
/apps/android/.gradle/
/apps/android/build/
/apps/android/**/build/
/apps/android/local.properties
*.apk
*.aab
*.keystore

# ---- Generated native build outputs ----
/build/

*.a
*.so
*.dylib
*.xcframework

# ---- Secrets ----
*.env
.env.local
google-services.json
GoogleService-Info.plist

# Generated app icons (scripts/gen-app-icon.mjs). Both platforms read them
# straight out of build/: Xcode through project.yml, Gradle through an extra
# res.srcDir. The Android copies used to be committed under
# apps/android/app/src/main/res "because Gradle needs them in the source tree",
# which is not true, and the app shipped for months with an icon nobody had
# regenerated.

# Android release signing: the keystore and its passwords stay out of the repo.
keystore.properties
# AdMob test devices: an identifier for someone's phone, and the list is
# per-person, not per-repo. Absent, the build ships with none, which is what
# anything reaching Play must do.
apps/android/admob.properties
*.jks
/build/parity-shots/

# Python bytecode from the asset generators.
__pycache__/
*.pyc

# Local scratch: screenshots pulled off a device, transfer staging, anything
# tried out and not meant to be kept.
/.qa/

# Screenshot renders. store/play-assets holds what was uploaded; these two are
# working sets, 25 MB of near-duplicates that no build reads.
/store/play-assets-design/
/store/play-assets-en/
